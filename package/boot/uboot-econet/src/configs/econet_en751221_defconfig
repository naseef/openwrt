#
# EcoNet EN751221 default configuration

# Architecture
CONFIG_MIPS=y
CONFIG_ARCH_ECONET=y
CONFIG_SOC_EN751221=y
CONFIG_BOARD_EN751221_GENERIC=y

# Memory
CONFIG_NR_DRAM_BANKS=1
CONFIG_SYS_MALLOC_LEN=0x100000

# Skip low-level init - factory bootloader already did it
CONFIG_SKIP_LOWLEVEL_INIT=y

# MIPS timer frequency: 450 MHz
# CP0 Count runs at half CPU frequency (900 MHz / 2 = 450 MHz)
CONFIG_SYS_MIPS_TIMER_FREQ=450000000

# Exception vectors - restore after relocation
CONFIG_RESTORE_EXCEPTION_VECTOR_BASE=y
# CONFIG_ROM_EXCEPTION_VECTORS is not set

# Boot
CONFIG_SYS_BOOTM_LEN=0x1000000
CONFIG_SYS_LOAD_ADDR=0x80020000

# Device Tree
CONFIG_DEFAULT_DEVICE_TREE="econet-en751221"
CONFIG_OF_CONTROL=y
CONFIG_OF_EMBED=y

# Console/UART - ns16550 with DM
CONFIG_BAUDRATE=115200
CONFIG_SYS_NS16550=y
CONFIG_SYS_NS16550_MEM32=y
CONFIG_DM_SERIAL=y

# Debug UART for early boot output
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_NS16550=y
CONFIG_DEBUG_UART_BASE=0xbfbf0000
CONFIG_DEBUG_UART_CLOCK=1843200
CONFIG_DEBUG_UART_SHIFT=2
CONFIG_DEBUG_UART_ANNOUNCE=y

# Logging
CONFIG_LOGLEVEL=7
CONFIG_LOG=y

# Commands - minimal set for initial testing
CONFIG_CMD_MEMORY=y
# CONFIG_CMD_CACHE is not set
CONFIG_CMD_CPU=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_MISC=y

# Disable unused features for smaller binary
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_XIMG is not set
# CONFIG_CMD_CRC32 is not set
# CONFIG_CMD_FLASH is not set
# CONFIG_CMD_LOADB is not set
# CONFIG_CMD_LOADS is not set
# CONFIG_INPUT is not set

# LZMA support for kernel decompression
CONFIG_LZMA=y
